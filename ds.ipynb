      "source": [
        "%matplotlib inline\n",
        "!pip install -q networkx numpy matplotlib pandas\n",
        "import numpy as np\n",
        "import networkx as nx\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from collections import defaultdict\n",
        "\n",
        "\n",
        "def ms(G, community):\n",
        "    nodes = list(community)\n",
        "    n = len(nodes)\n",
        "\n",
        "    if n <= 1:\n",
        "        return None, None\n",
        "\n",
        "    m = G.number_of_edges()\n",
        "\n",
        "    if m == 0:\n",
        "        return None, None\n",
        "\n",
        "    graph_nodes = list(G.nodes())\n",
        "\n",
        "    A = nx.to_numpy_array(\n",
        "        G,\n",
        "        nodelist=graph_nodes,\n",
        "        weight=None\n",
        "    )\n",
        "\n",
        "    k = A.sum(axis=1)\n",
        "\n",
        "    B = A - np.outer(k, k) / (2 * m)\n",
        "\n",
        "    node_index = {\n",
        "        node: i\n",
        "        for i, node in enumerate(graph_nodes)\n",
        "    }\n",
        "\n",
        "    indices = [\n",
        "        node_index[node]\n",
        "        for node in nodes\n",
        "    ]\n",
        "\n",
        "    B_sub = B[np.ix_(indices, indices)]\n",
        "\n",
        "    B_g = B_sub - np.diag(B_sub.sum(axis=1))\n",
        "\n",
        "    eigenvalues, eigenvectors = np.linalg.eigh(B_g)\n",
        "\n",
        "    largest_eigenvalue = eigenvalues[-1]\n",
        "\n",
        "    if largest_eigenvalue <= 1e-10:\n",
        "        return None, None\n",
        "\n",
        "    leading_vector = eigenvectors[:, -1]\n",
        "\n",
        "    comm1 = {\n",
        "        nodes[i]\n",
        "        for i, value in enumerate(leading_vector)\n",
        "        if value >= 0\n",
        "    }\n",
        "\n",
        "    comm2 = {\n",
        "        nodes[i]\n",
        "        for i, value in enumerate(leading_vector)\n",
        "        if value < 0\n",
        "    }\n",
        "\n",
        "    if not comm1 or not comm2:\n",
        "        return None, None\n",
        "\n",
        "    s = np.array([\n",
        "        1 if node in comm1 else -1\n",
        "        for node in nodes\n",
        "    ])\n",
        "\n",
        "    gain = (s @ B_g @ s) / (4 * m)\n",
        "\n",
        "    if gain <= 1e-10:\n",
        "        return None, None\n",
        "\n",
        "    return comm1, comm2\n",
        "\n",
        "\n",
        "def calculate_metrics_for_partition(G, partition, iteration):\n",
        "    metrics_data = []\n",
        "\n",
        "    for comm_index, community_nodes in enumerate(partition):\n",
        "        G_sub = G.subgraph(community_nodes)\n",
        "\n",
        "        deg_cen = nx.degree_centrality(G_sub)\n",
        "\n",
        "        bet_cen = nx.betweenness_centrality(\n",
        "            G_sub,\n",
        "            normalized=True,\n",
        "            endpoints=False\n",
        "        )\n",
        "\n",
        "        clo_cen = nx.closeness_centrality(G_sub)\n",
        "\n",
        "        clustering = nx.clustering(G_sub)\n",
        "\n",
        "        for node in community_nodes:\n",
        "            metrics_data.append({\n",
        "                'iteration': iteration,\n",
        "                'node': node,\n",
        "                'community_id': comm_index,\n",
        "                'community_size': len(community_nodes),\n",
        "                'degree': deg_cen.get(node, 0),\n",
        "                'betweenness': bet_cen.get(node, 0),\n",
        "                'closeness': clo_cen.get(node, 0),\n",
        "                'clustering': clustering.get(node, 0)\n",
        "            })\n",
        "\n",
        "    return metrics_data\n",
        "\n",
        "\n",
        "def plot_partition(G, partition, pos, ax, title):\n",
        "    color_map = {}\n",
        "\n",
        "    for comm_index, community_nodes in enumerate(partition):\n",
        "        for node in community_nodes:\n",
        "            color_map[node] = comm_index\n",
        "\n",
        "    node_colors = [\n",
        "        color_map.get(node, -1)\n",
        "        for node in G.nodes()\n",
        "    ]\n",
        "\n",
        "    nx.draw_networkx(\n",
        "        G,\n",
        "        pos=pos,\n",
        "        ax=ax,\n",
        "        node_color=node_colors,\n",
        "        cmap=plt.cm.jet,\n",
        "        node_size=500,\n",
        "        font_size=8,\n",
        "        with_labels=True,\n",
        "        edge_color='gray',\n",
        "        alpha=0.9\n",
        "    )\n",
        "\n",
        "    ax.set_title(title)\n",
        "    ax.set_axis_off()\n",
        "\n",
        "\n",
        "def run_recursive_partitioning():\n",
        "    print(\"Loading Zachary's Karate Club graph...\")\n",
        "\n",
        "    G = nx.karate_club_graph()\n",
        "\n",
        "    ground_truth_partition = defaultdict(set)\n",
        "\n",
        "    for node, data in G.nodes(data=True):\n",
        "        ground_truth_partition[data['club']].add(node)\n",
        "\n",
        "    ground_truth_partition = list(\n",
        "        ground_truth_partition.values()\n",
        "    )\n",
        "\n",
        "    current_partition = [set(G.nodes())]\n",
        "\n",
        "    partition_history = []\n",
        "    metrics_history = []\n",
        "\n",
        "    iteration = 0\n",
        "\n",
        "    def record_partition():\n",
        "        partition_copy = [\n",
        "            set(community)\n",
        "            for community in current_partition\n",
        "        ]\n",
        "\n",
        "        partition_history.append(partition_copy)\n",
        "\n",
        "        metrics_data = calculate_metrics_for_partition(\n",
        "            G,\n",
        "            partition_copy,\n",
        "            iteration\n",
        "        )\n",
        "\n",
        "        metrics_history.append(\n",
        "            pd.DataFrame(metrics_data)\n",
        "        )\n",
        "\n",
        "    record_partition()\n",
        "\n",
        "    def split_recursively(community):\n",
        "        nonlocal iteration\n",
        "\n",
        "        comm1, comm2 = ms(G, community)\n",
        "\n",
        "        if comm1 is None or comm2 is None:\n",
        "            return\n",
        "\n",
        "        community_index = next(\n",
        "            (\n",
        "                i\n",
        "                for i, c in enumerate(current_partition)\n",
        "                if c == community\n",
        "            ),\n",
        "            None\n",
        "        )\n",
        "\n",
        "        if community_index is None:\n",
        "            return\n",
        "\n",
        "        modularity_before = nx.community.modularity(\n",
        "            G,\n",
        "            current_partition\n",
        "        )\n",
        "\n",
        "        candidate_partition = (\n",
        "            current_partition[:community_index]\n",
        "            + [comm1, comm2]\n",
        "            + current_partition[community_index + 1:]\n",
        "        )\n",
        "\n",
        "        modularity_after = nx.community.modularity(\n",
        "            G,\n",
        "            candidate_partition\n",
        "        )\n",
        "\n",
        "        if modularity_after <= modularity_before + 1e-10:\n",
        "            print(\n",
        "                f\"Split rejected: \"\n",
        "                f\"{modularity_before:.4f} -> \"\n",
        "                f\"{modularity_after:.4f}\"\n",
        "            )\n",
        "            return\n",
        "\n",
        "        current_partition[:] = candidate_partition\n",
        "\n",
        "        iteration += 1\n",
        "\n",
        "        print(\n",
        "            f\"Iteration {iteration}: Split accepted. \"\n",
        "            f\"Modularity {modularity_before:.4f} -> \"\n",
        "            f\"{modularity_after:.4f}\"\n",
        "        )\n",
        "\n",
        "        record_partition()\n",
        "\n",
        "        split_recursively(comm1)\n",
        "        split_recursively(comm2)\n",
        "\n",
        "    print(\"Starting recursive modularity partitioning...\")\n",
        "\n",
        "    split_recursively(current_partition[0])\n",
        "\n",
        "    print(\"Partitioning complete.\")\n",
        "\n",
        "    all_metrics_df = (\n",
        "        pd.concat(metrics_history)\n",
        "        .set_index(['iteration', 'node'])\n",
        "        .sort_index()\n",
        "    )\n",
        "\n",
        "    return (\n",
        "        G,\n",
        "        partition_history,\n",
        "        all_metrics_df,\n",
        "        ground_truth_partition\n",
        "    )\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    G, partition_history, metrics_df, ground_truth = (\n",
        "        run_recursive_partitioning()\n",
        "    )\n",
        "\n",
        "    pos = nx.kamada_kawai_layout(G)\n",
        "\n",
        "    print(\"\\nGenerating partition visualizations...\")\n",
        "\n",
        "    num_iterations = len(partition_history)\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        1,\n",
        "        num_iterations + 1,\n",
        "        figsize=(6 * (num_iterations + 1), 6)\n",
        "    )\n",
        "\n",
        "    for i, partition in enumerate(partition_history):\n",
        "        plot_title = (\n",
        "            f\"Iteration {i}\\n\"\n",
        "            f\"({len(partition)} Communities)\"\n",
        "        )\n",
        "\n",
        "        plot_partition(\n",
        "            G,\n",
        "            partition,\n",
        "            pos,\n",
        "            axes[i],\n",
        "            plot_title\n",
        "        )\n",
        "\n",
        "    plot_partition(\n",
        "        G,\n",
        "        ground_truth,\n",
        "        pos,\n",
        "        axes[-1],\n",
        "        \"Ground Truth\\n(2 Communities)\"\n",
        "    )\n",
        "\n",
        "    plt.suptitle(\n",
        "        \"Evolution of Community Partitions\",\n",
        "        fontsize=20,\n",
        "        y=1.02\n",
        "    )\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plt.savefig(\n",
        "        \"community_evolution.png\",\n",
        "        bbox_inches='tight'\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "    print(\"Generating metric evolution plots...\")\n",
        "\n",
        "\n",
        "\n",
        "    metrics_to_plot = [\n",
        "        'degree',\n",
        "        'betweenness',\n",
        "        'closeness',\n",
        "        'clustering'\n",
        "    ]\n",
        "\n",
        "    fig, axes = plt.subplots(\n",
        "        len(metrics_to_plot),\n",
        "        1,\n",
        "        figsize=(15, 16),\n",
        "        sharex=True\n",
        "    )\n",
        "\n",
        "    for i, metric in enumerate(metrics_to_plot):\n",
        "        metric_evol_df = metrics_df[metric].unstack(level='node')\n",
        "\n",
        "        ax = axes[i]\n",
        "\n",
        "        for node in metric_evol_df.columns:\n",
        "            if node not in [0, 33]:\n",
        "                ax.plot(\n",
        "                    metric_evol_df.index,\n",
        "                    metric_evol_df[node],\n",
        "                    alpha=0.35,\n",
        "                    linewidth=1\n",
        "                )\n",
        "\n",
        "        if 0 in metric_evol_df.columns:\n",
        "            ax.plot(\n",
        "                metric_evol_df.index,\n",
        "                metric_evol_df[0],\n",
        "                color='red',\n",
        "                linewidth=2.5,\n",
        "                label='Node 0 (Mr. Hi)'\n",
        "            )\n",
        "\n",
        "        if 33 in metric_evol_df.columns:\n",
        "            ax.plot(\n",
        "                metric_evol_df.index,\n",
        "                metric_evol_df[33],\n",
        "                color='blue',\n",
        "                linewidth=2.5,\n",
        "                label='Node 33 (Officer)'\n",
        "            )\n",
        "\n",
        "        ax.set_title(\n",
        "            f'Evolution of {metric.title()} '\n",
        "            f'(within-community)',\n",
        "            fontsize=13\n",
        "        )\n",
        "\n",
        "        ax.set_ylabel('Metric Value')\n",
        "        ax.grid(True, linestyle='--', alpha=0.5)\n",
        "        ax.legend(loc='best')\n",
        "\n",
        "    axes[-1].set_xlabel('Iteration (Split Number)')\n",
        "    axes[-1].set_xticks(range(len(partition_history)))\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    plt.savefig(\n",
        "        \"metric_evolution.png\",\n",
        "        bbox_inches='tight',\n",
        "        dpi=150\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "    print(\"\\nFinal Metrics (at final iteration):\")\n",
        "\n",
        "    final_iter = metrics_df.index.get_level_values(\n",
        "        'iteration'\n",
        "    ).max()\n",
        "\n",
        "    print(\n",
        "        metrics_df\n",
        "        .xs(final_iter, level='iteration')\n",
        "        .sort_values('betweenness', ascending=False)\n",
        "    )\n",
        "\n",
       
      ]
    }
